# Install:
#   sudo cp server/systemd/deploy-webhook.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now deploy-webhook
[Unit]
Description=Deploy webhook for the dream-team.works portfolio
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
UMask=022
EnvironmentFile=/etc/deploy-webhook.env
ExecStart=/usr/bin/env python3 /srv/portofolio/server/deploy-webhook.py
Restart=on-failure
RestartSec=3

# Hardening. ReadWritePaths covers the git checkout and the webroot; if you
# change REPO_DIR/WEBROOT in /etc/deploy-webhook.env, update them here too.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/srv/portofolio /var/www/dream-team.works

[Install]
WantedBy=multi-user.target
