# Example environment for the deploy webhook service.
# Install to /etc/deploy-webhook.env (root, mode 600) and replace the token
# with a fresh one: openssl rand -hex 32
#
# Used by systemd unit deploy-webhook.service and by deploy-portfolio.sh.
DEPLOY_TOKEN=replace-with-a-long-random-token
PORT=8090
DEPLOY_TIMEOUT=300
BRANCH=master
REPO_DIR=/srv/portofolio
WEBROOT=/var/www/dream-team.works
DEPLOY_SCRIPT=/srv/portofolio/server/deploy-portfolio.sh
